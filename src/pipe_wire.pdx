// src/pipe_wire.pdx — umount.pdxfs.M3 (#9) — semantic-pipe schema bind
// + emit, falling back to a documented line-based rendering.
//
// ----------------------------------------------------------------------
// Why this is a fallback, not a real libpdx-semantic-pipe bind
// ----------------------------------------------------------------------
//
// `libpdx-semantic-pipe` (github.com/paideia-os/libpdx-semantic-pipe) is
// a real, released library with a working
// `Send::send_record(fd, rec_ptr, rec_len)` entry point that frames a
// record over `sys_ipc_send` once a schema is bound to an fd, either
// via a raw 32-byte hash the caller already knows
// (`Binding::libpdx_semantic_pipe_bind`) or by resolving a schema NAME
// via `Registry::bind_by_name(fd, name_ptr, name_len)`.
//
// `Registry::bind_by_name` is confirmed INERT: per paideia-os#2000
// ("Stand up libpdx-schema-registry service"), the service broker only
// knows two hardcoded test names and no `libpdx-schema-registry`
// service exists anywhere in the org -- `bind_by_name` always returns
// `LOOKUP_FAIL`. `umount.pdxfs` has no reader elsewhere in this
// monorepo family to hand-imprint a raw schema hash in agreement with
// (the one existing workaround, `ls`'s own placeholder-hash trick,
// only works because `ls` is both sender and the only reader that needs
// to agree) -- inventing one now would produce a wire format no
// consumer can actually interoperate over, which mkfs.pdxfs's own
// M3-003 `pipe_wire.pdx` documents as worse than not binding at all.
//
// Per the same fallback posture, this file does NOT link
// `libpdx-semantic-pipe`. Every `PdxFsUnmountRecord@0.1` this tool
// emits is the SAME line-based `sys_write(1, ...)` rendering
// `src/unmount_record.pdx`'s two emitters already produce, now preceded
// by one documented header line telling a human or script reading
// stdout exactly why. The field values themselves are unaffected --
// parties can still parse them. Once `libpdx-schema-registry` lands and
// #2000 closes, this file's two wrappers are the ONLY call sites that
// need to change (to a real `bind_by_name` + `send_record` pair); every
// other caller in this repo (`src/main.pdx`) already goes through them
// rather than calling `UnmountRecord`'s emitters directly.
//
// ----------------------------------------------------------------------
// "INTENT + RESULT + DEFERRED emissions" (#9's own wording)
// ----------------------------------------------------------------------
//
// This repo has no separate "intent, before the operation runs" record
// distinct from the M1 `--dry-run` preview line -- `unmount_record_
// emit_dry_run` already IS the pre-operation preview (`umnt_sp_emit_
// dry_run` below is its wrapper, serving as this file's INTENT
// emission). `umnt_sp_emit_result` below serves BOTH the RESULT and
// DEFERRED emissions #9 asks for -- they are the exact same wire shape
// (`PdxFsUnmountRecord@0.1`'s five-field result-code rendering,
// `src/unmount_record.pdx`'s `unmount_record_emit_result`), differing
// only in which `result_code` value main.pdx passes (`UR_RC_OK`/
// `UR_RC_KERNEL_ERROR`/... vs. `UR_RC_DEFERRED`) -- there is no reason
// to duplicate the five-segment emit logic into two near-identical
// wrapper functions for what is, on the wire, one record shape with a
// caller-chosen field value.
//
// ----------------------------------------------------------------------
// Register-preservation note
// ----------------------------------------------------------------------
//
// Both wrappers below issue one `sys_write` (for the header) BEFORE
// delegating to an `UnmountRecord` emitter that needs the original
// incoming arguments. Per this repo's own established convention
// (mirrored from mkfs.pdxfs's own `pipe_wire.pdx`): the kernel's #743
// info-leak hardening zeroes every CALLER-save register
// (`rdi`/`rsi`/`rdx`/`r8`/`r9`/`r10`) before every `sysret`. Staging the
// incoming arguments into any caller-save register across the header's
// `syscall` would silently lose them -- both functions below stage into
// SysV callee-save registers instead (`rbx`/`r12`-`r15`), matching
// `unmount_record_emit_dry_run`'s and `unmount_record_emit_result`'s
// own exact pattern, and pop them (reverse order) before their single
// `ret`.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic. Reserved-label
// discipline: every branch label in this file is prefixed `umnt_sp_`.
//
// Upstream: design/tooling/r49-r50-plan.md §3.2 (paideia-os, the
// semantic-pipe design); github.com/paideia-os/libpdx-semantic-pipe;
// GitHub issue paideia-os#2000 (the inert-registry blocker); mkfs.pdxfs's
// own src/pipe_wire.pdx (M3-003, #10 -- the identical fallback posture
// this file mirrors).

module PipeWire = structure {

  // --- Deferral header, printed to fd 1 immediately before every
  //     PdxFsUnmountRecord@0.1 line this repo emits. Length verified
  //     via `python3 -c "print(len(...))"`. ------------------------------
  pub let sp_lit_header     : [u8; 135] = "# semantic-pipe emit deferred (svc.schema-registry not yet live, paideia-os#2000) -- PdxFsUnmountRecord@0.1 line-based fallback below\n\0"
  pub let sp_lit_header_len : u64 = 134

  // ==========================================================================
  // umnt_sp_emit_dry_run(target_ptr, flags) -> ()
  //
  // Thin wrapper around UnmountRecord::unmount_record_emit_dry_run
  // (M1, unchanged): prints sp_lit_header first, then delegates both
  // arguments unchanged. This is main.pdx's INTENT emission (see module
  // header) and its ONLY call site for the --dry-run preview line.
  //
  // Register plan: rbx=target_ptr, r12=flags, both SysV callee-save,
  // pushed on entry and popped before the single `ret`.
  // ==========================================================================
  pub let umnt_sp_emit_dry_run : (u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (target_ptr: u64) (flags: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "umount.pdxfs.M3 (#9): umnt_sp_emit_dry_run entry point. push rbx; push r12 before repurposing either. rbx=target_ptr, r12=flags. sys_write(1, sp_lit_header, 134) -- SC+ ID 1, rdi/rsi/rdx/rax all freshly loaded for this call (per module header, neither rbx nor r12 is touched by it or by the kernel's post-syscall caller-save zeroing). Then rdi=rbx, rsi=r12, `call unmount_record_emit_dry_run` (src/unmount_record.pdx, M1, unchanged) -- delegates the real preview-line rendering verbatim. Pops r12/rbx (reverse push order) and returns. No `add reg,[mem]`. No `test`. Labels prefixed umnt_sp_ (none needed -- no branch).",
      block: {
        push rbx;
        push r12;

        mov rbx, rdi;                       // rbx = target_ptr
        mov r12, rsi;                       // r12 = flags

        mov rdi, 1;
        lea rsi, [rip + sp_lit_header];
        mov rdx, 134;                        // sp_lit_header_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, rbx;
        mov rsi, r12;
        call unmount_record_emit_dry_run;

        pop r12;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // umnt_sp_emit_result(target_ptr, mount_id, result_code, handle_count,
  //                      stub_mask) -> ()
  //
  // Thin wrapper around UnmountRecord::unmount_record_emit_result
  // (M2-003, extended M3 with DEFERRED/ELEVATION_STUB/SIG_KEY_LOCKED --
  // see that file's own header): prints sp_lit_header first, then
  // delegates all five arguments unchanged. This is main.pdx's ONLY
  // call site for BOTH the RESULT and DEFERRED emissions (#9's own
  // vocabulary -- see module header for why one function covers both).
  //
  // Register plan: rbx=target_ptr, r12=mount_id, r13=result_code,
  // r14=handle_count, r15=stub_mask -- same shape as
  // unmount_record_emit_result's own register plan.
  // ==========================================================================
  pub let umnt_sp_emit_result : (u64, u64, u64, u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (target_ptr: u64) (mount_id: u64) (result_code: u64) (handle_count: u64) (stub_mask: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "umount.pdxfs.M3 (#9): umnt_sp_emit_result entry point. push rbx/r12/r13/r14/r15 before repurposing any. rbx=target_ptr, r12=mount_id, r13=result_code, r14=handle_count, r15=stub_mask. sys_write(1, sp_lit_header, 134) -- SC+ ID 1. Then rdi=rbx, rsi=r12, rdx=r13, rcx=r14, r8=r15, `call unmount_record_emit_result` (src/unmount_record.pdx) -- delegates the real five-field rendering verbatim, now covering all seven UR_RC_* codes as of M3. Pops r15/r14/r13/r12/rbx (reverse push order) and returns. No `add reg,[mem]`. No `test`. Labels prefixed umnt_sp_ (none needed -- no branch).",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = target_ptr
        mov r12, rsi;                       // r12 = mount_id
        mov r13, rdx;                       // r13 = result_code
        mov r14, rcx;                       // r14 = handle_count
        mov r15, r8;                        // r15 = stub_mask

        mov rdi, 1;
        lea rsi, [rip + sp_lit_header];
        mov rdx, 134;                        // sp_lit_header_len
        mov rax, 1;                          // SC+ ID 1 = sys_write
        syscall;

        mov rdi, rbx;
        mov rsi, r12;
        mov rdx, r13;
        mov rcx, r14;
        mov r8, r15;
        call unmount_record_emit_result;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }
}
