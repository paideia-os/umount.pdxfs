// src/unmount_record.pdx — umount.pdxfs.M1-001 (scaffold) + M1-003 (#3)
// PdxFsUnmountRecord@0.1 emitter.
//
// design/tooling/volume-tooling-ux.md §5.6 defines the FULL
// PdxFsUnmountRecord@0.1 schema: audit_id, mount_id, volume_uuid,
// mount_point, invoker_user, dirty_pages_flushed, txns_drained,
// journal_state, result_code, open_handles, revoked_handles, deferred,
// ts_ns -- fifteen fields (counting `flags` is NOT one of them; see the
// note below), most of which require substrate this repo does not have
// at M1: a real mount-table lookup (umount.pdxfs.M2-001) for mount_id /
// volume_uuid / mount_point, a handle-count query
// (KIND_VOLUME.VOL_OP_QUERY_HANDLE_COUNT, umount.pdxfs.M2-002) for
// open_handles, a KIND_USER lookup (umount.pdxfs.M3-*) for
// invoker_user, a real clock read for ts_ns, and the cache-flush +
// txn-drain + checkpoint sequence (§5.5, umount.pdxfs.M2-003) for
// dirty_pages_flushed / txns_drained / journal_state.
//
// What THIS file emits at M1 is the exact three-field slice this
// issue's own acceptance text asks for -- a line-based, human-readable
// rendering on stdout of:
//
//   PdxFsUnmountRecord@0.1 { target: <target>, flags: <flags>,
//                            result_code: DRY_RUN }
//
// This is a REAL body, not a placeholder-value stub: `target` is the
// caller's actual raw <mount-id | mount-point> argv string
// (unclassified -- see argv.pdx's module header for why no
// mount-id-vs-path resolution happens at M1) and `flags` is a real
// decimal conversion of the caller's actual ParsedArgv.flags bitmask.
// `result_code` is always the literal `DRY_RUN` -- this module has no
// other caller at M1 (main.pdx only reaches unmount_record_emit_
// dry_run on the --dry-run branch).
//
// Note on `flags` vs. the §5.6 schema: `flags` as printed here is
// umount.pdxfs's own ParsedArgv bitmask (Argv::PA_FLAG_*, argv.pdx),
// NOT a field the upstream §5.6 schema itself defines -- the real
// schema has no `flags` field (mount-time flags like RO/NOEXEC belong
// to PdxFsMountRecord@0.1, not the unmount record). This issue's own
// task-brief print-line explicitly asks for `target`/`flags`/
// `result_code`, so this M1 slice prints exactly that trio; the real
// 15-field semantic-pipe emit at umount.pdxfs.M3-003 supersedes this
// text line entirely and does not carry `flags` forward as a distinct
// wire field (each caller-supplied argv flag instead feeds a
// corresponding real field: --lazy -> deferred/PENDING result_code,
// --force -> revoked_handles population, per §5.6).
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. Every byte load uses the
// `xor reg, reg; mov_b reg, [ptr]` zero-extension idiom. Byte STORES
// (e.g. `mov al, 0x30; mov [rsp], al`) are unaffected by the paideia-as
// #1248 load-side gap and use plain sub-register movs, matching
// src/user/init.pdx's print_u64_dec in the paideia-os monorepo and
// mkfs.pdxfs's own src/format_record.pdx (the precedent this file's
// decimal-conversion loop is adapted from). No `test` mnemonic; every
// zero-check is `cmp reg, 0`. No `imul`/`mul` (the decimal conversion
// only ever DIVIDES by the compile-time constant 10 via `div`, which is
// unaffected by this codebase's imul-avoidance convention -- that
// convention is about MULTIPLYING by a compile-time constant, not
// dividing). Reserved-label discipline: every branch label in this file
// is prefixed `umnt_ur_`.
//
// Upstream: design/tooling/volume-tooling-ux.md §5.6 (paideia-os);
// src/user/init.pdx print_u64_dec (paideia-os monorepo, the decimal-
// conversion precedent); mkfs.pdxfs/src/format_record.pdx (the sibling
// tool's own M1 record-emitter, whose shape this file mirrors).

module UnmountRecord = structure {

  // --- Literal chunks of the printed line. Lengths are exact byte
  //     counts (verified via `python3 -c "print(len(...))"` against
  //     each literal below), not counting any trailing NUL the storage
  //     array happens to add. -----------------------------------------
  pub let ur_lit_prefix     : [u8; 34] = "PdxFsUnmountRecord@0.1 { target: \0"
  pub let ur_lit_prefix_len : u64 = 33

  pub let ur_lit_flags     : [u8; 10] = ", flags: \0"
  pub let ur_lit_flags_len : u64 = 9

  pub let ur_lit_suffix     : [u8; 26] = ", result_code: DRY_RUN }\n\0"
  pub let ur_lit_suffix_len : u64 = 25

  // --- umount.pdxfs.M2-003 (#6) additions: unmount_record_emit_result's
  //     own literal chunks + result_code codes/words. See that
  //     function's own module-header note (below) for why this is a
  //     SEPARATE emitter rather than a extension of
  //     unmount_record_emit_dry_run -- the M1 dry-run line and the M2
  //     real-outcome line are different schemas (three fields vs. five)
  //     with no field overlap worth sharing beyond `target`. ------------

  // --- unmount_record_emit_result's numeric result_code values. Mirrored
  //     (duplicated, not cross-module-referenced -- see this repo's
  //     established "no pub let cross-module numeric reference"
  //     convention, e.g. libpdx-volume's mount_table_snapshot.pdx) in
  //     src/unmount_op.pdx's UO_RC_* and main.pdx's own literal 1/3. ----
  // --- umount.pdxfs.M3 (#7/#8/#10) additions to unmount_record_emit_
  //     result's result_code vocabulary: DEFERRED (--lazy, stubbed --
  //     see src/unmount_op.pdx), ELEVATION_STUB (--force, fail-closed
  //     -- see src/elevate.pdx), SIG_KEY_LOCKED (superblock re-sign
  //     refusal, real gate but unreachable at this landing -- see
  //     src/unmount_op.pdx's own module header for why). ------------
  pub let UR_RC_OK               : u64 = 0
  pub let UR_RC_IN_USE           : u64 = 1
  pub let UR_RC_KERNEL_ERROR     : u64 = 2
  pub let UR_RC_MOUNT_NOT_FOUND  : u64 = 3
  // --- umount.pdxfs.M3 additions (#7/#8/#10). Mirrored (duplicated,
  //     not cross-module-referenced -- see M2-003's own note on this
  //     repo's established convention) in src/unmount_op.pdx's
  //     UO_RC_DEFERRED/UO_RC_ELEVATION_STUB/UO_RC_SIG_KEY_LOCKED. -----
  pub let UR_RC_DEFERRED         : u64 = 4   // M3-001 (#7) -- --lazy stub
  pub let UR_RC_ELEVATION_STUB   : u64 = 5   // M3-002 (#8) -- --force fail-closed
  pub let UR_RC_SIG_KEY_LOCKED   : u64 = 6   // M3-004 (#10) -- unreachable, see unmount_op.pdx

  pub let ur_lit_mount_id     : [u8; 13] = ", mount_id: \0"
  pub let ur_lit_result_code  : [u8; 16] = ", result_code: \0"
  pub let ur_lit_handle_count : [u8; 17] = ", handle_count: \0"
  pub let ur_lit_stub_mask    : [u8; 14] = ", stub_mask: \0"
  pub let ur_lit_result_suffix : [u8; 4] = " }\n\0"

  pub let ur_lit_rc_ok               : [u8; 3]  = "OK\0"
  pub let ur_lit_rc_in_use           : [u8; 7]  = "IN_USE\0"
  pub let ur_lit_rc_kernel_error     : [u8; 13] = "KERNEL_ERROR\0"
  pub let ur_lit_rc_mount_not_found  : [u8; 16] = "MOUNT_NOT_FOUND\0"
  pub let ur_lit_rc_deferred         : [u8; 9]  = "DEFERRED\0"
  pub let ur_lit_rc_elevation_stub   : [u8; 15] = "ELEVATION_STUB\0"
  pub let ur_lit_rc_sig_key_locked   : [u8; 15] = "SIG_KEY_LOCKED\0"

  // ==========================================================================
  // unmount_record_strlen(s) -> u64
  //
  // Byte-loop strlen, identical shape to src/user/string.pdx's strlen in
  // the paideia-os monorepo and mkfs.pdxfs's own format_record_strlen.
  // Carries its own copy rather than a cross-module call, same
  // "no link-order dependency for one loop" posture mkfs.pdxfs's
  // format_record.pdx documents. Pure leaf: rax/rcx/rdi are SysV
  // caller-save.
  // ==========================================================================
  pub let unmount_record_strlen : (u64) -> u64 !{mem} @{} =
    fn (s: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "umount.pdxfs.M1-001/M1-003: unmount_record_strlen entry point. s in rdi. Loop: xor+mov_b loads *s into rcx (zero-extended); cmp rcx, 0; je umnt_ur_strlen_done on NUL; else add rax,1 (counter) and add rdi,1 (cursor), loop. Pure leaf -- rax/rcx/rdi all SysV caller-save, no push/pop. No `add reg,[mem]`, no `test` mnemonic. Labels prefixed umnt_ur_strlen_.",
      block: {
        xor rax, rax;

      umnt_ur_strlen_loop:
        xor rcx, rcx;
        mov_b rcx, [rdi];
        cmp rcx, 0;
        je umnt_ur_strlen_done;
        add rax, 1;
        add rdi, 1;
        jmp umnt_ur_strlen_loop;

      umnt_ur_strlen_done:
        ret;
      }
    }

  // ==========================================================================
  // unmount_record_emit_dry_run(target_ptr, flags) -> ()
  //
  //   rdi = target_ptr  (NUL-terminated <mount-id | mount-point> string,
  //                       e.g. ParsedArgv.target_ptr)
  //   rsi = flags       (u64 ParsedArgv.flags bitmask; see argv.pdx's
  //                       PA_FLAG_* constants)
  //
  // Writes exactly one line to fd 1 (stdout) via a fixed sequence of
  // sys_write calls, one per literal-or-dynamic segment -- same
  // "several small sys_write calls in sequence rather than one
  // buffer-assembly pass" convention mkfs.pdxfs's format_record_emit_
  // dry_run and cat.pdx's cat_open_err use. Segments, in wire order:
  //   1. ur_lit_prefix   "PdxFsUnmountRecord@0.1 { target: "
  //   2. target_ptr, length via unmount_record_strlen
  //   3. ur_lit_flags    ", flags: "
  //   4. flags, decimal-converted via an inline div-by-10 loop into a
  //      24-byte stack scratch buffer (identical algorithm to
  //      mkfs.pdxfs's format_record_emit_dry_run's journal_size
  //      segment, itself adapted from src/user/init.pdx's
  //      print_u64_dec in the paideia-os monorepo)
  //   5. ur_lit_suffix   ", result_code: DRY_RUN }\n"
  //
  // Never returns an error code -- sys_write's return value is ignored
  // on every call, matching mkfs.pdxfs's own posture at this maturity.
  // Caller (main.pdx) calls sys_exit itself after this returns.
  //
  // Register plan. rbx/r13 are SysV callee-save and are explicitly
  // saved (push) on entry and restored (pop) before the single `ret` --
  // this function is a public entry point a future caller may rely on
  // for register preservation (matching mkfs.pdxfs's format_record_
  // emit_dry_run and libpdx-audit's audit_send_record):
  //   rbx = target_ptr  (held across segment 2's nested call)
  //   r13 = flags       (held across segments 1-3, consumed at segment 4)
  //
  // No r12/r14 is needed: unlike mkfs.pdxfs's three-dynamic-value
  // record (target + optional label + journal_size), this record has
  // only two dynamic values, so two callee-save registers suffice.
  // unmount_record_strlen touches only rax/rcx/rdi (its own
  // justification), never rsi/rdx, so its return value in rax is moved
  // directly into rdx for the very next sys_write rather than being
  // stashed in a third callee-save register first.
  // ==========================================================================
  pub let unmount_record_emit_dry_run : (u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (target_ptr: u64) (flags: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "umount.pdxfs.M1-003 (#3): unmount_record_emit_dry_run entry point. SysV callee-save discipline: push rbx; push r13 (2 registers, 16 bytes) BEFORE repurposing either -- pops occur in reverse order immediately before the single `ret`. rbx=target_ptr, r13=flags, both now-saved SysV callee-save registers that survive the nested `call unmount_record_strlen` invocation and the several `syscall` instructions below (unmount_record_strlen clobbers only caller-save registers per its own justification; SYSCALL preserves callee-save registers by the amd64 fast-syscall convention, even though the kernel's #743 info-leak hardening zeroes rdi/rsi/rdx/r8/r9/r10 -- all caller-save -- before every sysret, which is exactly why this function reloads rdi/rsi/rdx fresh before every syscall rather than assuming any of them survive one). Segment 1: sys_write(1, ur_lit_prefix, 33) -- SC+ ID 1, rdi=fd, rsi=buf (rip-relative lea), rdx=count, rax=1, syscall. Segment 2: call unmount_record_strlen(rbx) -> rax = len, moved directly into rdx (no third callee-save register needed -- unmount_record_strlen never touches rsi/rdx); sys_write(1, rbx, rdx). Segment 3: sys_write(1, ur_lit_flags, 9). Segment 4: `sub rsp, 24` scratch (24 = 20 digit-buffer bytes + 4 alignment slop, matching mkfs.pdxfs's own sizing) then a zero-value special case (r13 == 0 writes a single '0' byte) or the general div-by-10 loop: r9 = remaining value, r10 = cursor starting at rsp+19 and walking DOWN (writes digits most-significant-last, so the final [cursor, rsp+20) slice is already MSB-first with no separate reversal pass -- identical algorithm to mkfs.pdxfs's format_record_emit_dry_run journal_size segment). `add rsp, 24` restores the stack after the digit sys_write. Segment 5: sys_write(1, ur_lit_suffix, 25). Pops r13/rbx (reverse push order) and returns (no value; caller sys_exits itself). No `add reg,[mem]` (the digit-count computation `mov rax,rsp; add rax,20; sub rax,r10` operates on registers only, never adding a memory operand). No `test` mnemonic. No `imul`/`mul` -- only `div` by the compile-time constant 10. Labels prefixed umnt_ur_.",
      block: {
        push rbx;
        push r13;

        mov rbx, rdi;                       // rbx = target_ptr
        mov r13, rsi;                       // r13 = flags

        // ---- Segment 1: "PdxFsUnmountRecord@0.1 { target: " -------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_prefix];
        mov rdx, 33;                        // ur_lit_prefix_len
        mov rax, 1;                         // SC+ ID 1 = sys_write
        syscall;

        // ---- Segment 2: target string --------------------------------------
        mov rdi, rbx;
        call unmount_record_strlen;
        mov rdx, rax;                       // rdx = target_len
        mov rdi, 1;
        mov rsi, rbx;
        mov rax, 1;
        syscall;

        // ---- Segment 3: ", flags: " ---------------------------------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_flags];
        mov rdx, 9;                         // ur_lit_flags_len
        mov rax, 1;
        syscall;

        // ---- Segment 4: flags, decimal --------------------------------------
        sub rsp, 24;

        cmp r13, 0;
        jne umnt_ur_flags_setup;

        // Zero special case: single '0' digit.
        mov al, 0x30;
        mov [rsp], al;
        mov rdi, 1;
        mov rsi, rsp;
        mov rdx, 1;
        mov rax, 1;
        syscall;
        jmp umnt_ur_flags_done;

      umnt_ur_flags_setup:
        mov r9, r13;                        // r9 = remaining value
        mov r10, rsp;
        add r10, 19;                        // r10 = cursor at last staging byte

      umnt_ur_flags_loop:
        mov rax, r9;
        mov rcx, 10;
        xor rdx, rdx;                       // zero-extend rdx:rax for div
        div rcx;                            // rax = quotient, rdx = remainder
        add rdx, 0x30;                      // digit -> ASCII '0'..'9'
        mov [r10], dl;                      // store at cursor
        mov r9, rax;                        // r9 = quotient
        cmp r9, 0;
        je umnt_ur_flags_emit;
        sub r10, 1;                         // advance cursor left (MSB-ward)
        jmp umnt_ur_flags_loop;

      umnt_ur_flags_emit:
        // r10 points at the first (MSB) digit. Length = (rsp + 20) - r10.
        mov rax, rsp;
        add rax, 20;
        sub rax, r10;                       // rax = digit count
        mov rdx, rax;                       // sys_write count
        mov rdi, 1;                         // fd
        mov rsi, r10;                       // buf
        mov rax, 1;                         // SC+ ID 1 = sys_write
        syscall;

      umnt_ur_flags_done:
        add rsp, 24;

        // ---- Segment 5: ", result_code: DRY_RUN }\n" ------------------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_suffix];
        mov rdx, 25;                        // ur_lit_suffix_len
        mov rax, 1;
        syscall;

        pop r13;
        pop rbx;
        ret;
      }
    }

  // ==========================================================================
  // unmount_record_write_u64_dec(fd, value) -> ()
  //
  // umount.pdxfs.M2-003 (#6): shared decimal-conversion-and-write helper,
  // extracted from unmount_record_emit_dry_run's own segment-4 inline
  // logic (identical div-by-10 algorithm; see that function's own
  // justification for the full derivation) since unmount_record_emit_
  // result (below) needs the same conversion three times (mount_id,
  // handle_count, stub_mask) and inlining it three times would triple
  // the boilerplate for no benefit -- this repo's own "one module per
  // public-entry-point family" granularity note (design/architecture.md
  // §2) extends naturally to "one shared helper once a pattern repeats
  // 3+ times in the same file".
  //
  //   rdi = fd     destination file descriptor (always 1/stdout at every
  //                current call site, but not hard-coded so a future
  //                fd-2 diagnostic reuse needs no change here)
  //   rsi = value  the u64 to render in decimal
  //
  // Leaf with local stack scratch only: rax/rcx/rdx/r9/r10/al are all
  // SysV caller-save; r11 holds fd across the single `syscall` at the
  // end (r11 is untouched by the div loop, so no push/pop is needed --
  // this function makes exactly one syscall, so there is no
  // repeated-reload hazard from the kernel's #743 caller-save-register
  // zeroing on sysret).
  // ==========================================================================
  pub let unmount_record_write_u64_dec : (u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (fd: u64) (value: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "umount.pdxfs.M2-003 (#6): unmount_record_write_u64_dec entry point. r11 = fd (rdi), held across the whole function since the div loop below never touches r11 and only one `syscall` occurs at the very end -- no push/pop needed, no repeated-reload hazard. `sub rsp,24` scratch (matches unmount_record_emit_dry_run's own segment-4 sizing rationale: 20 digit-buffer bytes + 4 alignment slop). Zero-value special case (rsi==0): writes a single '0' byte. General case (umnt_ur_wd_setup/_loop): r9 = remaining value (rsi), r10 = cursor at rsp+19 walking DOWN (MSB-last-write, no reversal pass needed, identical to unmount_record_emit_dry_run's segment 4); each iteration divides r9 by the compile-time constant 10 via `div rcx` (rcx=10; this is a DIVISION by a constant, not a multiply, so it is unaffected by this repo's imul/mul-avoidance convention, which concerns constant MULTIPLICATION), converts the remainder to ASCII, stores at the cursor, and loops until the quotient hits 0. umnt_ur_wd_emit computes the digit count as `(rsp+20) - cursor` and issues the single sys_write(r11, cursor, count). `add rsp,24` restores the stack; ret. No `add reg,[mem]`. No `test` mnemonic. No `imul`/`mul`. Labels prefixed umnt_ur_wd_.",
      block: {
        mov r11, rdi;                       // r11 = fd
        sub rsp, 24;

        cmp rsi, 0;
        jne umnt_ur_wd_setup;

        mov al, 0x30;
        mov [rsp], al;
        mov rdi, r11;
        mov rsi, rsp;
        mov rdx, 1;
        mov rax, 1;
        syscall;
        jmp umnt_ur_wd_done;

      umnt_ur_wd_setup:
        mov r9, rsi;                        // r9 = remaining value
        mov r10, rsp;
        add r10, 19;                        // cursor at last staging byte

      umnt_ur_wd_loop:
        mov rax, r9;
        mov rcx, 10;
        xor rdx, rdx;                       // zero-extend rdx:rax for div
        div rcx;                            // rax = quotient, rdx = remainder
        add rdx, 0x30;                      // digit -> ASCII '0'..'9'
        mov [r10], dl;
        mov r9, rax;                        // r9 = quotient
        cmp r9, 0;
        je umnt_ur_wd_emit;
        sub r10, 1;                         // advance cursor left (MSB-ward)
        jmp umnt_ur_wd_loop;

      umnt_ur_wd_emit:
        mov rax, rsp;
        add rax, 20;
        sub rax, r10;                       // rax = digit count
        mov rdx, rax;
        mov rdi, r11;
        mov rsi, r10;
        mov rax, 1;                         // SC+ ID 1 = sys_write
        syscall;

      umnt_ur_wd_done:
        add rsp, 24;
        ret;
      }
    }

  // ==========================================================================
  // unmount_record_emit_result(target_ptr, mount_id, result_code,
  //                             handle_count, stub_mask) -> ()
  //
  // umount.pdxfs.M2-003 (#6): the real (non-dry-run) PdxFsUnmountRecord
  // @0.1 emitter. Prints, to fd 1:
  //
  //   PdxFsUnmountRecord@0.1 { target: <target>, mount_id: <id>,
  //     result_code: <OK|IN_USE|KERNEL_ERROR|MOUNT_NOT_FOUND>,
  //     handle_count: <n>, stub_mask: <mask> }
  //
  // This is a DIFFERENT (and separately-maintained) five-field slice
  // from the full 15-field §5.6 schema, and a different function from
  // unmount_record_emit_dry_run's three-field DRY_RUN-only line -- see
  // this repo's module header for why M1's slice omits everything this
  // function adds. `stub_mask` is NOT a §5.6 schema field either; it is
  // this M2 landing's own task-scoped rendering of src/unmount_op.pdx's
  // UO_STUB_* accumulator (see that file's module header for the bit
  // meanings: bit0=sys_umount syscall unwired/-ENOSYS, bit1=cache-flush
  // stub, bit2=checkpoint stub, bit3=superblock-resign stub, bit4=row-
  // remove stub), decimal-rendered since this repo has no hex printer.
  // A MOUNT_NOT_FOUND-result call always passes stub_mask=0 (no
  // substep ever ran) and a mount_id of 0 (unresolved -- caller never
  // reads target_resolve's out-pointer on that path, per that
  // function's own "untouched on failure" contract, so 0 is main.pdx's
  // own explicit placeholder, not a real slot index).
  //
  //   rdi = target_ptr    NUL-terminated raw <mount-id | mount-point> string
  //   rsi = mount_id      resolved mount_id (0 placeholder if unresolved)
  //   rdx = result_code   UR_RC_OK | UR_RC_IN_USE | UR_RC_KERNEL_ERROR |
  //                       UR_RC_MOUNT_NOT_FOUND (anything else also
  //                       renders as MOUNT_NOT_FOUND -- the cmp chain's
  //                       fall-through arm -- rather than a fifth,
  //                       undefined word)
  //   rcx = handle_count  from HandleCheck::handle_check_refuse's
  //                       out-pointer (always 0 at M2 -- see
  //                       src/handle_check.pdx)
  //   r8  = stub_mask     from UnmountOp::unmount_op's out-pointer (0 on
  //                       the MOUNT_NOT_FOUND / IN_USE paths, which
  //                       never call unmount_op)
  //
  // Register plan (all SysV callee-save; pushed on entry, popped at the
  // single shared epilogue before `ret` -- same discipline
  // unmount_record_emit_dry_run and Argv::argv_parse follow):
  //   rbx = target_ptr   (survives the nested unmount_record_strlen call)
  //   r12 = mount_id     (survives to segment 4)
  //   r13 = result_code  (survives to segment 6's cmp chain)
  //   r14 = handle_count (survives to segment 8)
  //   r15 = stub_mask    (survives to segment 10)
  // Five registers needed (one per dynamic value) since, unlike
  // unmount_record_emit_dry_run's two dynamic values, this function has
  // five and every one of them is read AFTER at least one intervening
  // `syscall` (which zeroes caller-save registers on return per the
  // kernel's #743 hardening) or nested `call`.
  // ==========================================================================
  pub let unmount_record_emit_result : (u64, u64, u64, u64, u64) -> () !{mem, sysreg} @{fs} =
    fn (target_ptr: u64) (mount_id: u64) (result_code: u64) (handle_count: u64) (stub_mask: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs},
      justification: "umount.pdxfs.M2-003 (#6) + M3 (#7/#8/#10): unmount_record_emit_result entry point. SysV callee-save discipline: pushes rbx/r12/r13/r14/r15 (5 registers, 40 bytes) before repurposing any, pops all five (reverse order) at the single shared epilogue before `ret`. rbx=target_ptr, r12=mount_id, r13=result_code, r14=handle_count, r15=stub_mask -- all now-saved callee-save regs surviving every nested `call`/`syscall` below. Eleven segments in wire order, each a literal-then-optionally-dynamic sys_write pair (or a single dynamic call for the four decimal segments): (1) ur_lit_prefix 'PdxFsUnmountRecord@0.1 { target: ' (33B). (2) target string via unmount_record_strlen(rbx) -> rdx=len, sys_write(1,rbx,rdx). (3) ur_lit_mount_id ', mount_id: ' (12B). (4) `call unmount_record_write_u64_dec` with rdi=1,rsi=r12 (mount_id). (5) ur_lit_result_code ', result_code: ' (15B). (6) result_code word selection: cmp r13 against 0/1/2/4/5/6 in turn (umnt_ur_res_ok/_in_use/_kernel_error/_deferred/_elevation_stub/_sig_key_locked -- the M3 arms (#7/#8/#10) added after the M2 three), each setting rsi/rdx to its literal+len and jumping to umnt_ur_res_emit; any other value (including the canonical 3 = UR_RC_MOUNT_NOT_FOUND) falls through to the MOUNT_NOT_FOUND literal before umnt_ur_res_emit issues the one shared sys_write(1,rsi,rdx). (7) ur_lit_handle_count ', handle_count: ' (16B). (8) `call unmount_record_write_u64_dec` with rdi=1,rsi=r14 (handle_count). (9) ur_lit_stub_mask ', stub_mask: ' (13B). (10) `call unmount_record_write_u64_dec` with rdi=1,rsi=r15 (stub_mask). (11) ur_lit_result_suffix ' }\\n' (3B). Every literal-only segment reloads rdi=1/rax=1 fresh before its own `syscall` rather than assuming any caller-save register survives a prior syscall (matches unmount_record_emit_dry_run's own documented rationale: the kernel's #743 hardening zeroes rdi/rsi/rdx/r8/r9/r10 on every sysret). No `add reg,[mem]` anywhere. No `test` mnemonic. Labels prefixed umnt_ur_res_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdi;                       // rbx = target_ptr
        mov r12, rsi;                       // r12 = mount_id
        mov r13, rdx;                       // r13 = result_code
        mov r14, rcx;                       // r14 = handle_count
        mov r15, r8;                        // r15 = stub_mask

        // ---- Segment 1: "PdxFsUnmountRecord@0.1 { target: " -------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_prefix];
        mov rdx, 33;                        // ur_lit_prefix_len
        mov rax, 1;
        syscall;

        // ---- Segment 2: target string ---------------------------------------
        mov rdi, rbx;
        call unmount_record_strlen;
        mov rdx, rax;
        mov rdi, 1;
        mov rsi, rbx;
        mov rax, 1;
        syscall;

        // ---- Segment 3: ", mount_id: " --------------------------------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_mount_id];
        mov rdx, 12;
        mov rax, 1;
        syscall;

        // ---- Segment 4: mount_id, decimal ------------------------------------
        mov rdi, 1;
        mov rsi, r12;
        call unmount_record_write_u64_dec;

        // ---- Segment 5: ", result_code: " ------------------------------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_result_code];
        mov rdx, 15;
        mov rax, 1;
        syscall;

        // ---- Segment 6: result_code word ---------------------------------------
        cmp r13, 0;
        je umnt_ur_res_ok;
        cmp r13, 1;
        je umnt_ur_res_in_use;
        cmp r13, 2;
        je umnt_ur_res_kernel_error;
        cmp r13, 4;
        je umnt_ur_res_deferred;
        cmp r13, 5;
        je umnt_ur_res_elevation_stub;
        cmp r13, 6;
        je umnt_ur_res_sig_key_locked;

        lea rsi, [rip + ur_lit_rc_mount_not_found];
        mov rdx, 15;
        jmp umnt_ur_res_emit;

      umnt_ur_res_ok:
        lea rsi, [rip + ur_lit_rc_ok];
        mov rdx, 2;
        jmp umnt_ur_res_emit;

      umnt_ur_res_in_use:
        lea rsi, [rip + ur_lit_rc_in_use];
        mov rdx, 6;
        jmp umnt_ur_res_emit;

      umnt_ur_res_kernel_error:
        lea rsi, [rip + ur_lit_rc_kernel_error];
        mov rdx, 12;
        jmp umnt_ur_res_emit;

      umnt_ur_res_deferred:
        lea rsi, [rip + ur_lit_rc_deferred];
        mov rdx, 8;
        jmp umnt_ur_res_emit;

      umnt_ur_res_elevation_stub:
        lea rsi, [rip + ur_lit_rc_elevation_stub];
        mov rdx, 14;
        jmp umnt_ur_res_emit;

      umnt_ur_res_sig_key_locked:
        lea rsi, [rip + ur_lit_rc_sig_key_locked];
        mov rdx, 14;

      umnt_ur_res_emit:
        mov rdi, 1;
        mov rax, 1;
        syscall;

        // ---- Segment 7: ", handle_count: " ------------------------------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_handle_count];
        mov rdx, 16;
        mov rax, 1;
        syscall;

        // ---- Segment 8: handle_count, decimal ------------------------------------
        mov rdi, 1;
        mov rsi, r14;
        call unmount_record_write_u64_dec;

        // ---- Segment 9: ", stub_mask: " ------------------------------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_stub_mask];
        mov rdx, 13;
        mov rax, 1;
        syscall;

        // ---- Segment 10: stub_mask, decimal ------------------------------------
        mov rdi, 1;
        mov rsi, r15;
        call unmount_record_write_u64_dec;

        // ---- Segment 11: " }\n" ------------------------------------
        mov rdi, 1;
        lea rsi, [rip + ur_lit_result_suffix];
        mov rdx, 3;
        mov rax, 1;
        syscall;

        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }
}
