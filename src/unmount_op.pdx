// src/unmount_op.pdx — umount.pdxfs.M2-003 (issue #6) + M3-001 (#7) +
// M3-002 (#8) + M3-004 (#10)
// Non-force happy path (M2), --lazy DEFERRED stub (M3-001), --force
// elevate+revoke stub (M3-002), and the SIG_KEY_LOCKED refusal gate
// over a REAL (placeholder-buffer) superblock re-sign attempt (M3-004).
//
// design/tooling/volume-tooling-ux.md §5.5 sketches six steps. This
// file drives all six; per M2-003's own instruction, every substep
// that has no landed kernel/library primitive STUBS gracefully
// (documented, mask bit set) rather than aborting the pipeline —
// **only a genuine sys_umount error aborts** (see step 1).
//
// ----------------------------------------------------------------------
// M3 addition — a new gate BEFORE step 1, driven by handle_count
// ----------------------------------------------------------------------
//
// `handle_check.pdx`'s M3-001 `handle_check_refuse` now lets a nonzero
// handle_count through (instead of refusing) whenever `--lazy` OR
// `--force` is set — the actual arbitration between "wait" (lazy) and
// "revoke and proceed anyway" (force) is THIS file's job, since it is
// the one place both `umount_flags` and a real (or, today, hard-stubbed
// at 0 — see `handle_check.pdx`'s own module header) `handle_count` are
// both in hand. `unmount_op` therefore grows a THIRD argument,
// `handle_count`, and a new gate ahead of the existing six-step
// pipeline:
//
//   handle_count > 0 AND lazy_bit set:
//     Real "would-defer" semantics have no kernel-side callback this
//     tool can register (there is no `sys_umount` completion-notify
//     primitive, and no `PENDING_UNMOUNT` flag anywhere in
//     `KIND_PDXFS_MOUNT_TABLE`'s real row layout to set). Per this
//     issue's own instruction, this is STUBBED: `unmount_op` emits the
//     `UO_RC_DEFERRED` result CODE immediately (main.pdx forwards this
//     into `PdxFsUnmountRecord@0.1`'s `result_code: DEFERRED` field) —
//     but no follow-up "now actually unmounted" completion record ever
//     fires, since there is no last-handle-closed callback to fire it
//     from. Stub bit `UO_STUB_LAZY_DEFERRED` (0x20) documents this.
//     Steps 1-5 below never run on this arm — a lazy caller is told
//     "deferred", not "kernel-error" or "OK", and the pipeline stops
//     there.
//
//   handle_count > 0 AND lazy_bit NOT set (force_bit therefore set —
//   `handle_check_refuse` never lets a plain nonzero-handle-count
//   through with neither flag; see that file's own module header):
//     Real force-unmount semantics need (a) an elevate grant (mount
//     points under `/system`/`/boot`/`/dev` per §5.2/§8.2) and (b) a
//     kernel handle-revocation primitive. Neither exists — see
//     `src/elevate.pdx`'s own module header for (a)'s missing
//     broker-endpoint-cap gap (mirroring mkfs.pdxfs's M3-005 posture
//     over the identical library), and no `KIND_VOLUME` op or syscall
//     anywhere in the kernel tree performs (b). This file calls
//     `Elevate::elevate_request_force_unmount` FOR REAL; that call
//     always returns `ELEV_DENY` today (fail-closed), so `unmount_op`
//     returns `UO_RC_ELEVATION_STUB` immediately — steps 1-5 never run
//     on this arm either. The `ELEV_GRANT` arm (handle-revoke stub,
//     bit `UO_STUB_HANDLE_REVOKE` = 0x80, then falling through to the
//     normal six-step pipeline) is real, wired code, unreachable at
//     this landing — kept for the day a broker-endpoint cap exists, per
//     `elevate.pdx`'s own module header.
//
//   handle_count == 0 (the ONLY reachable arm today, since
//   `handle_check_query`'s hard stub always returns 0 — see that
//   file's module header): falls straight into the unchanged M2
//   six-step pipeline below, regardless of `umount_flags`. This is
//   deliberate and matches real semantics: `--lazy`/`--force` only
//   change anything when there is something to wait-for or revoke.
//
// ----------------------------------------------------------------------
// Steps 1-5 (M2-003, unchanged in shape) — step 4 upgraded at M3-004
// ----------------------------------------------------------------------
//
// `src/kernel/core/syscall/sys_umount.pdx` (R53.M2-003, #1738) landed a
// COMPLETE real body (`sys_umount_body` + `sys_umount_shim`) months
// ago. But `src/kernel/core/syscall/dispatch.pdx`'s `dispatch_umount`
// label (sysno 76) is STILL the original R53.M2-001 (#1736)
// forward-declaration `-ENOSYS` stub, per this file's own long-standing
// finding (unchanged as of this M3 landing — **still flagged for
// main**). Step 1 issues the real syscall anyway and treats the
// deterministic `-ENOSYS` as a documented stub condition (bit 0),
// falling through to steps 2-5; any OTHER negative return is a genuine
// failure that aborts (`UO_RC_KERNEL_ERROR`).
//
// Step 2 (cache flush + txn drain) and step 3 (CLEAN checkpoint) are
// unchanged M2 stubs — no `KIND_VOLUME` op name and no userspace-
// callable checkpoint primitive exist. Stub bits `UO_STUB_CACHE_FLUSH`
// (0x2) / `UO_STUB_CHECKPOINT` (0x4).
//
// Step 4 (superblock re-sign) is UPGRADED at M3-004 (#10) from a pure
// stub to a REAL, wired call — see the next section.
//
// Step 5 (row remove) is unchanged — `KIND_PDXFS_MOUNT_TABLE`'s real
// op catalog (`PMT_OP_MAX` = 3) still has no remove/delete op. Stub bit
// `UO_STUB_ROW_REMOVE` (0x10).
//
// ----------------------------------------------------------------------
// M3-004 (#10) — step 4 becomes a REAL pdxb_sign_superblock call over a
// placeholder buffer; SIG_KEY_LOCKED is real, wired, and unreachable
// ----------------------------------------------------------------------
//
// This tool still has no block-device read primitive and no live
// 4096-byte (`PDXB_ONDISK_BYTES`) on-disk superblock buffer to sign —
// that gap (M2-003's own finding) has not closed. What HAS changed at
// M3-004: rather than skip the call entirely (M2's posture), this
// file now calls `libpdx-volume.pdxb_sign_superblock` FOR REAL against
// a local, deliberately-placeholder `PDXB_ONDISK_BYTES` `.bss` scratch
// buffer
// (`umnt_op_sb_scratch`) and a local all-zero 32-byte seed buffer
// (`umnt_op_seed_zero`) — the exact same "real, safe, wired call
// against an honest placeholder input" pattern `src/target_resolve.pdx`
// already established for `mount_table_snapshot`. `pdxb_sign_
// superblock`'s own contract (libpdx-volume, M3-001 #7) is pure
// register/pointer arithmetic plus the `MlDsa65::sign` intrinsic — it
// never faults on a non-null, correctly-sized buffer regardless of its
// contents, so this call is safe from ring 3 even though the buffer is
// not a real on-disk superblock.
//
// Per this issue's own instruction: "if `pdxb_sign_superblock` returns
// an error (e.g., seed unavailable), emit SIG_KEY_LOCKED and refuse."
// This gate is REAL and LIVE: `cmp rax, 3309; jne
// umnt_op_sign_locked`. But `pdxb_sign_superblock` only ever returns
// its `PDXB_SIGN_ERR` sentinel when the underlying `MlDsa65::sign`
// intrinsic itself returns nonzero — and that intrinsic's own documented
// failure case is a NULL `seed_ptr` (libpdx-volume's own module
// header). `umnt_op_seed_zero` is a real, non-null, all-zero 32-byte
// buffer — "the seed is unavailable" and "the seed is all-zero" are
// different conditions, and this landing only has the latter. The
// intrinsic therefore always succeeds against this buffer, and
// `UO_RC_SIG_KEY_LOCKED` is unreachable through this call chain at this
// landing — exactly the posture this issue's own instruction
// anticipates ("this path is unreachable — STUB with test noting it").
// `tests/test_lazy_stub.pdx`'s sibling test coverage for this file (see
// `tests/README.md`) documents the same reachability finding rather
// than fabricating a seed-unavailable condition that does not exist
// anywhere in this tool's own call graph.
//
// On the (unreachable) sign-failure arm, the pipeline aborts (skips
// step 5) and returns `UO_RC_SIG_KEY_LOCKED` — a refusal, not a
// completion, per this issue's own "refuse" instruction. On the
// (always-taken) success arm, `UO_STUB_SB_RESIGN` (0x8) is still set —
// its meaning is now "step 4 ran a REAL sign call against a placeholder
// buffer, not the genuine on-disk superblock" rather than M2's "no call
// was made at all"; the bit value is unchanged so a reader diffing
// stub_mask across M2/M3 records sees the same bit position, only the
// documented meaning has strengthened.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Reserved-label discipline: every branch label in this
// file is prefixed `umnt_op_`. Pointer arithmetic for the sign call's
// `out_sig_ptr = &umnt_op_sb_scratch + PDXB_SIGN_MSG_LEN (696)` uses a
// single-symbol `lea reg, [rip + umnt_op_sb_scratch]` followed by
// `add reg, 696` (register + compile-time immediate) — never a
// two-register `lea`, matching libpdx-volume's own
// `pdxb_sign_inode_tail` precedent for pointer-plus-offset arithmetic.
//
// ----------------------------------------------------------------------
// libpdx-volume v1.1 adoption (umount.pdxfs #21)
// ----------------------------------------------------------------------
//
// This file adopts libpdx-volume v1.1 in the CONSTANT-CITE dimension:
//
//   * `PDXB_ONDISK_BYTES` (LV.M1-005, libpdx-volume #20) is now the
//     documented name for the 4096-byte on-disk superblock width;
//     `umnt_op_sb_scratch`'s `.bss` reserve stays the numeric literal
//     paideia-as accepts in `[u8; N]` position and the comment cites
//     `PDXB_ONDISK_BYTES`.
//
//   * `PDXB_SIGN_MSG_LEN` (libpdx-volume signed-range constant, 696
//     bytes) is now the documented name for the `out_sig_ptr = sb_ptr
//     + 696` offset; the `add rdx, 696` immediate below cites it. This
//     is the same constant `pdxb_sign_superblock` itself uses
//     internally (see that file's own body — the signed range is
//     `sb_ptr[0, 696)`, sig writes start at `sb_ptr + 696`).
//
//   * `MLDSA65_SIG_LEN` (libpdx-volume signature-length constant, 3309
//     bytes) is now the documented name for the `out_sig_len` argument
//     and the success-arm sentinel; both `mov rcx, 3309` and `cmp rax,
//     3309` cite it below.
//
//   * `pdxb_sign_superblock` itself remains a bare-label cross-repo
//     call — v1.1 introduced accessors/consts, not a new signature
//     wrapper, so no call-site rewrite is needed here.
//
//   * `lpv_strerror` (LV.M1-004, libpdx-volume #19): this file emits
//     no human-readable error strings from libpdx-volume codes -- the
//     sign-failure arm (`umnt_op_sign_locked`) surfaces to the caller
//     as `UO_RC_SIG_KEY_LOCKED` (a `UnmountRecord::UR_RC_*` code
//     stringified by `unmount_record.pdx`'s own literals table), not
//     as a rendered libpdx-volume error string. No stringify wiring is
//     added; the finding is documented in this repo's v1.1.0
//     CHANGELOG entry rather than fabricated as a wire point.
//
//   * `MountTableRow` / `MountTableEntry` accessors (LV.M1-003): this
//     file does not touch either structure -- mount-table decoding
//     lives in `src/target_resolve.pdx`.
//
// Upstream: design/tooling/volume-tooling-ux.md §5.5, §5.4, §5.2, §8.2
// (paideia-os); src/kernel/core/syscall/sys_umount.pdx + dispatch.pdx
// (the unwired-dispatch finding); src/kernel/core/cap/
// kind_pdxfs_mount_table.pdx (PMT_OP_MAX=3); libpdx-volume's
// src/pdxb_sign.pdx (pdxb_sign_superblock's real body + the
// MlDsa65::sign intrinsic's NULL-seed-only failure contract); this
// repo's src/handle_check.pdx (the new lazy_bit-aware refusal gate) and
// src/elevate.pdx (the fail-closed force-unmount elevation stub).

module UnmountOp = structure {

  // --- unmount_op status codes. Deliberately share numeric values with
  //     UnmountRecord::UR_RC_* (0/2/4/5/6/8/9) -- this repo's own
  //     established "no cross-module pub let numeric reference"
  //     convention (see M2-003's own module header for the precedent).
  //     1 (IN_USE) and 3 (MOUNT_NOT_FOUND) are deliberately skipped --
  //     unmount_op never returns either; those are main.pdx's own
  //     literals for the two gates that run BEFORE unmount_op is ever
  //     called. 7 (SYSTEM_UNMOUNT_REFUSED) is likewise main.pdx's own
  //     code for the LE-001 gate that runs before unmount_op. --------
  pub let UO_RC_OK               : u64 = 0
  pub let UO_RC_KERNEL_ERROR     : u64 = 2
  pub let UO_RC_DEFERRED         : u64 = 4   // M3-001 (#7)
  pub let UO_RC_ELEVATION_STUB   : u64 = 5   // M3-002 (#8)
  pub let UO_RC_SIG_KEY_LOCKED   : u64 = 6   // M3-004 (#10) -- unreachable, see header
  // --- PFS-15 (paideia-os#2582) additions: --force end-to-end. --------
  pub let UO_RC_NO_ELEVATE       : u64 = 8   // broker-endpoint cap unprovisioned (ELEV_NO_SLOT)
  pub let UO_RC_REVOKE_FAIL      : u64 = 9   // VOL_OP_REVOKE_HANDLE refused mid-sweep

  // --- Stub-mask bits (see module header for the full write-up). -----------
  pub let UO_STUB_SYS_UMOUNT_ENOSYS : u64 = 0x1
  pub let UO_STUB_CACHE_FLUSH       : u64 = 0x2
  pub let UO_STUB_CHECKPOINT        : u64 = 0x4
  pub let UO_STUB_SB_RESIGN         : u64 = 0x8   // M3-004: real call, placeholder buffer
  pub let UO_STUB_ROW_REMOVE        : u64 = 0x10
  pub let UO_STUB_LAZY_DEFERRED     : u64 = 0x20  // M3-001 (#7)
  pub let UO_STUB_ELEVATION_DENIED  : u64 = 0x40  // M3-002 (#8)
  pub let UO_STUB_HANDLE_REVOKE     : u64 = 0x80  // M3-002 (#8) -- unreachable (ELEV_GRANT arm); PFS-15 reclaims this bit as "revoke sweep ran successfully, kernel-side body still stubbed"
  pub let UO_STUB_SIG_KEY_LOCKED    : u64 = 0x100 // M3-004 (#10) -- unreachable, see header
  pub let UO_STUB_NO_ELEVATE        : u64 = 0x200 // PFS-15: broker-endpoint slot not provisioned
  pub let UO_STUB_REVOKE_FAIL       : u64 = 0x400 // PFS-15: at least one VOL_OP_REVOKE_HANDLE returned nonzero

  // --- sys_umount's -ENOSYS sentinel (standard errno 38, negated). ---------
  pub let UO_ENOSYS : u64 = 0xFFFFFFFFFFFFFFDA

  // --- M3-004: placeholder superblock + seed scratch for the REAL
  //     pdxb_sign_superblock call. Neither buffer is the genuine
  //     on-disk superblock or a real signing seed -- see module header.
  //     `.bss` zero-init is sufficient here: the sign call's own
  //     correctness never depends on these bytes' VALUES, only on both
  //     pointers being non-null and umnt_op_sb_scratch being >=
  //     PDXB_SIGN_MSG_LEN (696) readable bytes (it is PDXB_ONDISK_BYTES
  //     = 4096; both constants are libpdx-volume v1.1 public consts,
  //     LV.M1-005 / #20). ---------------------------------------------
  pub let mut umnt_op_sb_scratch : [u8; 4096] = uninit @align(8)   // PDXB_ONDISK_BYTES
  pub let mut umnt_op_seed_zero  : [u8; 32]   = uninit @align(8)   // MLDSA65_SEED_LEN

  // --- PFS-15 (paideia-os#2582): revoke-sweep scratch. handle_count and
  //     the per-iteration counter both live in .bss rather than on the
  //     stack: SysV %16 alignment at the nested elevate/syscall call
  //     sites would need a counting push/pop pair per iteration, while
  //     the kernel's #743 info-leak hardening zeroes caller-save
  //     registers on sysret (so even a register-held index would need to
  //     be reloaded from somewhere every iteration). unmount_op is
  //     non-reentrant (one unmount at a time per task), so a shared
  //     module-level pair is correct. Both are u64, zero-initialised by
  //     the loader before `_start` runs. ------------------------------
  pub let mut umnt_op_revoke_count : u64 = uninit @align(8)
  pub let mut umnt_op_revoke_idx   : u64 = uninit @align(8)

  // ==========================================================================
  // unmount_op(mount_id, umount_flags, handle_count, out_stub_mask_ptr) -> u64
  //     (UO_RC_OK | UO_RC_KERNEL_ERROR | UO_RC_DEFERRED |
  //      UO_RC_ELEVATION_STUB | UO_RC_SIG_KEY_LOCKED)
  //
  //   rdi = mount_id           resolved _mount_table[] slot index
  //   rsi = umount_flags       caller-premasked ParsedArgv.flags &
  //                            (PA_FLAG_LAZY|PA_FLAG_FORCE)
  //   rdx = handle_count       HandleCheck::handle_check_refuse's
  //                            out-pointer value (always 0 at this
  //                            landing via that file's own hard stub --
  //                            see module header). NEW at M3-001 (#7).
  //   rcx = out_stub_mask_ptr  u64 write target; ALWAYS written on
  //                            every return path
  //
  // Register plan: r12 = out_stub_mask_ptr, r13 = stub_mask
  // accumulator, r14 = mount_id, r15 = umount_flags -- all SysV
  // callee-save, pushed on entry / popped before the single `ret`.
  // handle_count (rdx) is consumed once, immediately, before any of
  // r12-r15 are assigned, and is dead thereafter -- no callee-save slot
  // is spent holding it. rdi/rsi (mount_id/umount_flags) are copied
  // into r14/r15 rather than left in place because BOTH the elevate
  // call (a plain SysV `call`, which clobbers caller-save registers)
  // and the real `syscall` (which the kernel's #743 info-leak hardening
  // zeroes every caller-save register on return from) intervene before
  // mount_id/umount_flags are needed again.
  // ==========================================================================
  pub let unmount_op : (u64, u64, u64, u64) -> u64 !{mem, sysreg} @{fs, cap} =
    fn (mount_id: u64) (umount_flags: u64) (handle_count: u64) (out_stub_mask_ptr: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {fs, cap},
      justification: "umount.pdxfs.M2-003 (#6) + M3-001 (#7) + M3-002 (#8) + M3-004 (#10) + PFS-15 (paideia-os#2582): unmount_op entry point. PFS-15 (--force end-to-end): the elevate call now returns three distinct values (ELEV_DENY=0 wired-but-unreachable broker refusal; ELEV_GRANT=1 proceed to revoke sweep; ELEV_NO_SLOT=2 broker-endpoint cap unprovisioned, the only reachable fail-closed arm today), mapped to three distinct UO_RC_* codes (UO_RC_ELEVATION_STUB=5 / UO_RC_NO_ELEVATE=8 / UO_RC_REVOKE_FAIL=9) via three distinct branch arms (umnt_op_force_granted / umnt_op_no_elevate / fallthrough ELEV_DENY). The GRANT arm then runs a real revoke sweep: handle_count stashed into .bss scratch umnt_op_revoke_count before the elevate call (so SysV %16 at the nested call site is preserved without stack use, and the counter survives the loop's inner SYSCALLs); the loop reads [rip + umnt_op_revoke_idx] + [rip + umnt_op_revoke_count], builds op_arg = (i << 8) | VOL_OP_REVOKE_HANDLE (11), issues `cap_invoke(vol_slot, op_arg)` via SC+ ID 4, and aborts the sweep on any nonzero return (treating the no-slot case -- INVOKE_RESULT_INVALID_HANDLE -- as a revoke failure, i.e. fail-closed). On full-sweep success, sets UO_STUB_HANDLE_REVOKE (0x80, reclaimed meaning from M3-002's unreachable stub to 'sweep ran OK against kernel-side VOL_OP_REVOKE_HANDLE stub'). The ELEV_NO_SLOT arm sets UO_STUB_NO_ELEVATE (0x200) and the REVOKE_FAIL arm sets UO_STUB_REVOKE_FAIL (0x400). PRIOR DOC BELOW (unchanged shape, M2/M3 descriptions kept verbatim). Pushes r12/r13/r14/r15 before repurposing any; pops all four (reverse order) at the single shared epilogue before `ret`. r12=out_stub_mask_ptr (rcx), r13=stub_mask (xor-zeroed), r14=mount_id (rdi), r15=umount_flags (rsi) -- handle_count (rdx) is read ONCE, immediately, before this staging (`cmp rdx,0; je umnt_op_pipeline` skips the whole lazy/force gate when handle_count==0, the only reachable value today per handle_check.pdx's own stub). On handle_count>0: `mov rax,r15; and rax,0x1` (PA_FLAG_LAZY); nonzero -> umnt_op_lazy_deferred: `or r13,0x20` (UO_STUB_LAZY_DEFERRED), write stub_mask, return UO_RC_DEFERRED (4) -- steps 1-5 never run. Otherwise `mov rax,r15; and rax,0x2` (PA_FLAG_FORCE); zero -> falls through to umnt_op_pipeline anyway (handle_count>0 with neither flag is unreachable via handle_check_refuse's own gating, but this file does not re-refuse -- it simply has nothing special to do, matching handle_check.pdx's documented posture). Nonzero force_bit: `mov rdi,r14; call elevate_request_force_unmount` (src/elevate.pdx, real fail-closed call) -> rax in {ELEV_DENY=0, ELEV_GRANT=1}; `cmp rax,1; je umnt_op_force_granted`. DENY (the only reachable value): `or r13,0x40` (UO_STUB_ELEVATION_DENIED), write stub_mask, return UO_RC_ELEVATION_STUB (5) -- steps 1-5 never run. umnt_op_force_granted (real, wired, unreachable): `or r13,0x80` (UO_STUB_HANDLE_REVOKE, documenting the no-kernel-primitive handle-revoke stub) then falls into umnt_op_pipeline exactly like the handle_count==0 case. umnt_op_pipeline (steps 1-5, r14/r15 restored into rdi/rsi for the syscall): mov rdi,r14; mov rsi,r15; mov rax,76; syscall (Step 1, SC+ ID 76 = sys_umount) -- staging r10=UO_ENOSYS sentinel, cmp rax,r10; je umnt_op_umount_enosys (or r13,0x1 then fall through); cmp rax,0; je umnt_op_umount_ok; else genuine kernel error: write stub_mask, return UO_RC_KERNEL_ERROR (2), skipping steps 2-5. umnt_op_umount_ok: or r13,0x2 (cache flush stub); or r13,0x4 (checkpoint stub). Step 4 (M3-004, REAL call): lea rdi,[rip+umnt_op_sb_scratch] (sb_ptr); lea rsi,[rip+umnt_op_seed_zero] (seed_ptr); lea rdx,[rip+umnt_op_sb_scratch]; add rdx,696 (out_sig_ptr = sb_ptr+696, register+immediate, never a two-register lea); mov rcx,3309 (out_sig_len); call pdxb_sign_superblock (libpdx-volume, cross-repo bare-label call, same mechanism target_resolve.pdx already uses for mount_table_snapshot) -> rax. `cmp rax,3309; jne umnt_op_sign_locked` -- unreachable per module header (the intrinsic only fails on a NULL seed_ptr, and umnt_op_seed_zero is a real non-null buffer), but real and live: on that arm, or r13,0x100 (UO_STUB_SIG_KEY_LOCKED), write stub_mask, return UO_RC_SIG_KEY_LOCKED (6), skipping step 5. On the (always-taken) success arm: or r13,0x8 (UO_STUB_SB_RESIGN, now meaning 'real call, placeholder buffer'). Step 5: or r13,0x10 (row remove stub, unchanged). Write final stub_mask; xor rax,rax (UO_RC_OK); fall into the shared epilogue. Epilogue pops r15/r14/r13/r12 (reverse push order) and returns. No `add reg,[mem]`. No `test` mnemonic. Labels prefixed umnt_op_.",
      block: {
        push r12;
        push r13;
        push r14;
        push r15;

        mov r12, rcx;                       // r12 = out_stub_mask_ptr
        xor r13, r13;                       // r13 = stub_mask = 0
        mov r14, rdi;                       // r14 = mount_id
        mov r15, rsi;                       // r15 = umount_flags

        // ---- M3 gate: handle_count > 0 -> lazy-defer or force-elevate. -----
        cmp rdx, 0;
        je umnt_op_pipeline;

        mov rax, r15;
        and rax, 0x1;                       // PA_FLAG_LAZY
        cmp rax, 0;
        je umnt_op_check_force;

        // ---- --lazy, handle_count > 0: DEFERRED stub (#7). ------------------
        or r13, 0x20;                       // UO_STUB_LAZY_DEFERRED
        mov [r12 + 0], r13;
        mov rax, 4;                         // UO_RC_DEFERRED
        jmp umnt_op_epilogue;

      umnt_op_check_force:
        mov rax, r15;
        and rax, 0x2;                       // PA_FLAG_FORCE
        cmp rax, 0;
        je umnt_op_pipeline;                 // neither flag: unreachable via caller gating

        // ---- --force, handle_count > 0: elevate check (real call, #8/PFS-15). -----
        //      Return codes: ELEV_DENY (0) = broker-side refusal (unreachable
        //      today, kept wired); ELEV_GRANT (1) = proceed to revoke sweep;
        //      ELEV_NO_SLOT (2) = broker-endpoint cap unprovisioned, the
        //      PFS-15 fail-closed arm reached whenever `_init_caps` has not
        //      yet seeded slot 5 (the only reachable value at this landing,
        //      pending PFS-02 kernel-side enablement). The three arms report
        //      three DISTINCT UO_RC_* codes so main.pdx can select the
        //      operator-visible exit (ELEVATION_STUB=7 vs NO_ELEVATE=10 vs
        //      REVOKE_FAIL=11); the record emitter likewise prints three
        //      distinct `result_code` words.
        //
        //      Stash handle_count (rdx, caller-save) into the .bss scratch
        //      `umnt_op_revoke_count` BEFORE the elevate call -- SysV %16
        //      alignment at the nested call site is preserved by not
        //      touching the stack, and the scratch survives the revoke
        //      loop's inner SYSCALLs too.
        mov [rip + umnt_op_revoke_count], rdx;
        mov rdi, r14;                       // mount_id
        call elevate_request_force_unmount; // src/elevate.pdx

        cmp rax, 1;                         // Elevate::ELEV_GRANT
        je umnt_op_force_granted;
        cmp rax, 2;                         // Elevate::ELEV_NO_SLOT
        je umnt_op_no_elevate;

        // ---- ELEV_DENY (real, wired, unreachable today -- the broker-side
        //      refusal; PFS-15's reachable fail-closed arm is ELEV_NO_SLOT
        //      above). Reports UO_RC_ELEVATION_STUB for operator-visible
        //      backward compatibility with M3-002's exit code (7). --------
        or r13, 0x40;                       // UO_STUB_ELEVATION_DENIED
        mov [r12 + 0], r13;
        mov rax, 5;                         // UO_RC_ELEVATION_STUB
        jmp umnt_op_epilogue;

      umnt_op_no_elevate:
        // ---- PFS-15: broker-endpoint cap not provisioned (the only
        //      reachable fail-closed arm today). Reports UO_RC_NO_ELEVATE
        //      so main.pdx can exit with UMOUNT_ERR_NO_ELEVATE (10). ------
        or r13, 0x200;                      // UO_STUB_NO_ELEVATE
        mov [r12 + 0], r13;
        mov rax, 8;                         // UO_RC_NO_ELEVATE
        jmp umnt_op_epilogue;

      umnt_op_force_granted:
        // ---- PFS-15: real revoke sweep -- iterate handle_count VOL_OP_
        //      REVOKE_HANDLE cap_invokes. Each iteration packs the index
        //      into op_arg[63:8] + op=11 in op_arg[7:0] and issues `cap_
        //      invoke(vol_slot, op_arg)` via SC+ ID 4. On any nonzero
        //      return (VOL_OK=0 is success; INVOKE_DENIED, INVOKE_UNSUP,
        //      VOL_TAIL_BAD_ARG, etc. are failures), the sweep aborts to
        //      umnt_op_revoke_fail and reports UO_RC_REVOKE_FAIL. On a
        //      zero-slot .bss sentinel (reachable today, pending the
        //      mount-table -> cap-slot wire described in handle_check.pdx's
        //      `umnt_vol_cap_slot` comment), the sweep ALSO fails safe --
        //      issuing cap_invoke against slot 0 would surface INVOKE_
        //      RESULT_INVALID_HANDLE (0xFFFFFFFFFFFFFFFE), which the
        //      per-iteration gate below treats as a failure, so the no-
        //      slot case reports UO_RC_REVOKE_FAIL rather than wrongly
        //      proceeding. On full success (every revoke returned VOL_OK),
        //      sets UO_STUB_HANDLE_REVOKE (0x80, reclaimed from its M3-
        //      002 "unreachable" meaning to "sweep ran OK, kernel-side
        //      body still stubbed per kind_volume.pdx's VOL_OP_REVOKE_
        //      HANDLE declaration") and falls into the normal six-step
        //      pipeline.
        //
        //      Register plan for the loop:
        //        r8  = iteration index i (caller-save, zeroed in SYSCALL
        //              return register wipe -- the kernel's #743 info-
        //              leak hardening zeroes caller-save on sysret, so
        //              r8 is reloaded fresh from the .bss counter
        //              `umnt_op_revoke_idx` every iteration).
        //        [rip + umnt_op_revoke_count] = handle_count (unchanged
        //              across the loop body -- a straightforward loop
        //              bound).
        //        [rip + umnt_op_revoke_idx]  = iteration counter.
        xor rax, rax;
        mov [rip + umnt_op_revoke_idx], rax; // i = 0

      umnt_op_revoke_loop:
        mov r8, [rip + umnt_op_revoke_idx];
        mov rax, [rip + umnt_op_revoke_count];
        cmp r8, rax;
        jae umnt_op_revoke_done;

        // Build op_arg = (i << 8) | VOL_OP_REVOKE_HANDLE (11).
        mov rsi, r8;
        shl rsi, 8;
        or  rsi, 0xB;                       // op code VOL_OP_REVOKE_HANDLE (11) in bits [7:0]

        mov rdi, [rip + umnt_vol_cap_slot]; // slot (0 -> cap_invoke returns INVALID_HANDLE sentinel, caught below)
        mov rax, 4;                         // SC+ ID 4 = cap_invoke
        syscall;

        cmp rax, 0;                         // VOL_OK
        jne umnt_op_revoke_fail;

        // Advance iteration counter via .bss (SYSCALL may have wiped r8).
        mov rax, [rip + umnt_op_revoke_idx];
        add rax, 1;
        mov [rip + umnt_op_revoke_idx], rax;
        jmp umnt_op_revoke_loop;

      umnt_op_revoke_done:
        or r13, 0x80;                       // UO_STUB_HANDLE_REVOKE (sweep ran OK)
        jmp umnt_op_pipeline;

      umnt_op_revoke_fail:
        or r13, 0x400;                      // UO_STUB_REVOKE_FAIL
        mov [r12 + 0], r13;
        mov rax, 9;                         // UO_RC_REVOKE_FAIL
        jmp umnt_op_epilogue;

      umnt_op_pipeline:
        // ---- Step 1: real sys_umount attempt (sysno 76). -------------------
        mov rdi, r14;                       // mount_id
        mov rsi, r15;                       // umount_flags
        mov rax, 76;                        // SC+ ID 76 = sys_umount(mount_id, flags)
        syscall;

        mov r10, 0xFFFFFFFFFFFFFFDA;        // UO_ENOSYS sentinel
        cmp rax, r10;
        je umnt_op_umount_enosys;

        cmp rax, 0;
        je umnt_op_umount_ok;

        // ---- Genuine kernel error: abort, skip steps 2-5. -------------------
        mov [r12 + 0], r13;                 // *out_stub_mask_ptr = stub_mask so far
        mov rax, 2;                         // UO_RC_KERNEL_ERROR
        jmp umnt_op_epilogue;

      umnt_op_umount_enosys:
        or r13, 0x1;                        // UO_STUB_SYS_UMOUNT_ENOSYS

      umnt_op_umount_ok:
        // ---- Steps 2-3: no landed primitive; stub each. ---------------------
        or r13, 0x2;                        // UO_STUB_CACHE_FLUSH
        or r13, 0x4;                        // UO_STUB_CHECKPOINT

        // ---- Step 4 (M3-004, #10): REAL pdxb_sign_superblock call. ----------
        lea rdi, [rip + umnt_op_sb_scratch]; // sb_ptr (placeholder buffer)
        lea rsi, [rip + umnt_op_seed_zero];  // seed_ptr (all-zero, non-null)
        lea rdx, [rip + umnt_op_sb_scratch];
        add rdx, 696;                        // out_sig_ptr = sb_ptr + PDXB_SIGN_MSG_LEN (696)
        mov rcx, 3309;                       // out_sig_len = MLDSA65_SIG_LEN (3309)
        call pdxb_sign_superblock;           // libpdx-volume, cross-repo call

        cmp rax, 3309;                       // MLDSA65_SIG_LEN: bytes-written success sentinel
        jne umnt_op_sign_locked;

        or r13, 0x8;                        // UO_STUB_SB_RESIGN (real call, placeholder buf)
        jmp umnt_op_step5;

      umnt_op_sign_locked:
        // ---- Unreachable at this landing -- see module header. -------------
        or r13, 0x100;                      // UO_STUB_SIG_KEY_LOCKED
        mov [r12 + 0], r13;
        mov rax, 6;                         // UO_RC_SIG_KEY_LOCKED
        jmp umnt_op_epilogue;

      umnt_op_step5:
        or r13, 0x10;                       // UO_STUB_ROW_REMOVE

        mov [r12 + 0], r13;                 // *out_stub_mask_ptr = stub_mask
        xor rax, rax;                       // UO_RC_OK

      umnt_op_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        ret;
      }
    }
}
