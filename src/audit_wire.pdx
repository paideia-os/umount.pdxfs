// src/audit_wire.pdx — umount.pdxfs.M3 (#9) — libpdx-audit INTENT +
// DEFERRED + RESULT journal wrapping.
//
// ----------------------------------------------------------------------
// libpdx-audit @0.2 API this file wires against
// ----------------------------------------------------------------------
//
// `libpdx-audit` (paideia-satellites/libpdx-audit, @0.2, commit
// bfc63a5) exposes a `module AuditClient` this file calls three ways,
// mapping onto this issue's own "INTENT + RESULT + DEFERRED emissions"
// vocabulary one-for-one:
//
//   audit_begin(op_name_ptr, op_args_ptr) -> u64   -- the INTENT record
//     (internally `UEJ_KIND_TOOL_INVOKE`). Returns a wire audit_id on
//     success, or 0 on failure -- see "forgiving posture" below.
//   audit_record_output(audit_id, output_schema_ptr, output_hash) -> u64
//     -- a mid-lifecycle marker (`UEJ_KIND_TOOL_OUTPUT`). This file
//     calls it exactly once, only on the `--lazy` DEFERRED arm, so a
//     supervisor replaying the journal can see "this invocation
//     deferred" as a distinct event BEFORE the terminal RESULT record,
//     rather than only ever seeing begin-then-commit. `output_hash` is
//     always 0 here -- there is no real completion payload to hash (the
//     deferred unmount never actually finishes within this process; see
//     `src/unmount_op.pdx`'s own module header for why no follow-up
//     completion record can ever fire).
//   audit_commit(audit_id, exit_code) -> u64        -- the RESULT record
//     (internally `UEJ_KIND_TOOL_EXIT`). Called exactly once per
//     invocation, on every terminal path (main.pdx wraps EVERY exit,
//     including argv-parse failure's own separate no-audit-opened path
//     -- see main.pdx's own module header).
//
// All three are cross-repo bare-label calls (`call audit_begin;`, etc.),
// the identical mechanism `src/target_resolve.pdx` already uses for
// `mount_table_snapshot` and `src/unmount_op.pdx` (M3-004) now uses for
// `pdxb_sign_superblock`.
//
// ----------------------------------------------------------------------
// Forgiving posture: every outcome is non-fatal (mirrors mkfs.pdxfs's
// own M3-004 audit_wire.pdx precedent exactly)
// ----------------------------------------------------------------------
//
// `umnt_audit_begin` returns whatever `audit_begin` returns, including
// 0 on failure, with no error branch of its own -- a 0 audit_id is a
// valid "auditing did not happen" sentinel main.pdx threads through
// unexamined. `umnt_audit_commit` and `umnt_audit_record_deferred` both
// treat audit_id == 0 as "nothing was opened, nothing to record" and
// skip their own call entirely (matching `AuditClient::audit_commit`'s
// own `AUDIT_ERR_ID_MISMATCH` gate, which a zero id would otherwise
// hit for no benefit). This matches libpdx-audit's own STATUS.md note
// that the kernel-side broker dispatch is still stubbed
// (`audit_journal_broker_dispatch` returns `AJB_DISPATCH_STUB`) -- a
// quick no-op from any of these three calls is an EXPECTED outcome at
// this landing, not an error condition main.pdx needs to surface.
//
// ----------------------------------------------------------------------
// op_name literals -- a real per-invocation signal, not a placeholder
// ----------------------------------------------------------------------
//
// `umnt_audit_begin` selects one of three `op_name` literals from the
// caller's actual `(force_bit, lazy_bit)` pair, so the audit trail
// distinguishes a plain unmount from a `--force` or `--lazy` invocation
// before the operation's outcome is even known -- the real INTENT
// signal this issue's own "INTENT" emission asks for. `--force` takes
// priority in the (structurally impossible per argv.pdx, but handled
// defensively) case both flags are set, matching this repo's own
// "last-token-wins" tolerance for other double-specified inputs.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. No `test` mnemonic. Reserved-label
// discipline: every branch label in this file is prefixed `umnt_audit_`.
//
// Upstream: paideia-satellites/libpdx-audit @0.2 (commit bfc63a5),
// src/audit_client.pdx (AuditClient::audit_begin/audit_record_output/
// audit_commit); mkfs.pdxfs's own src/audit_wire.pdx (M3-004, #11 --
// the identical forgiving-posture precedent this file follows).

module AuditWire = structure {

  // --- op_name literals. Lengths verified via
  //     `python3 -c "print(len(...))"`. -------------------------------
  pub let umnt_audit_lit_op_name       : [u8; 21] = "umount.pdxfs.unmount\0"
  pub let umnt_audit_lit_op_name_lazy  : [u8; 26] = "umount.pdxfs.unmount.lazy\0"
  pub let umnt_audit_lit_op_name_force : [u8; 27] = "umount.pdxfs.unmount.force\0"

  // ==========================================================================
  // umnt_audit_begin(target_ptr, force_bit, lazy_bit) -> u64
  //   (the wire audit_id AuditClient::audit_begin returned, or 0 -- see
  //   module header's "forgiving posture" note)
  //
  //   rdi = target_ptr  (NUL-terminated <target> string, passed through
  //                       verbatim as audit_begin's op_args)
  //   rsi = force_bit   (0 or nonzero -- selects the .force op_name)
  //   rdx = lazy_bit    (0 or nonzero -- selects the .lazy op_name)
  //
  // force_bit takes priority over lazy_bit when both are nonzero (see
  // module header). No push/pop needed: target_ptr is staged into rax
  // (caller-save) across the branch below, and the one `call
  // audit_begin` is a plain SysV call (not a `syscall` trap), so this
  // staging survives it safely -- matching mkfs_audit_begin's own
  // documented rationale.
  // ==========================================================================
  pub let umnt_audit_begin : (u64, u64, u64) -> u64 !{mem, sysreg} @{cap, sched} =
    fn (target_ptr: u64) (force_bit: u64) (lazy_bit: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "umount.pdxfs.M3 (#9): umnt_audit_begin entry point. rax = target_ptr (staged from rdi before rdi is repurposed for the op_name literal pointer). `cmp rsi,0; jne umnt_audit_begin_force` selects the .force literal first (priority per module header); else `cmp rdx,0; jne umnt_audit_begin_lazy` selects .lazy; else falls through to the plain literal. Each arm does `lea rdi,[rip+<literal>]` then jumps to umnt_audit_begin_have_name. `mov rsi, rax` (op_args = target_ptr, restored from staging). `call audit_begin` (libpdx-audit, cross-repo bare-label call). Its return value (rax) IS this function's return value verbatim -- no examination, per module header's forgiving posture. No `add reg,[mem]`. No `test`. Labels prefixed umnt_audit_.",
      block: {
        mov rax, rdi;                       // stage target_ptr

        cmp rsi, 0;
        jne umnt_audit_begin_force;

        cmp rdx, 0;
        jne umnt_audit_begin_lazy;

        lea rdi, [rip + umnt_audit_lit_op_name];
        jmp umnt_audit_begin_have_name;

      umnt_audit_begin_force:
        lea rdi, [rip + umnt_audit_lit_op_name_force];
        jmp umnt_audit_begin_have_name;

      umnt_audit_begin_lazy:
        lea rdi, [rip + umnt_audit_lit_op_name_lazy];

      umnt_audit_begin_have_name:
        mov rsi, rax;                       // op_args = target_ptr
        call audit_begin;
        ret;
      }
    }

  // ==========================================================================
  // umnt_audit_record_deferred(audit_id) -> ()
  //
  // umount.pdxfs.M3-001 (#7) tie-in: the "DEFERRED" mid-lifecycle audit
  // emission this issue's own "INTENT + RESULT + DEFERRED emissions"
  // instruction names. Called ONLY from main.pdx's `--lazy` DEFERRED
  // arm, once, before the terminal `umnt_audit_commit`.
  //
  //   rdi = audit_id  (umnt_audit_begin's return value; 0 skips -- see
  //                     module header)
  //
  // output_hash is always 0 (no real completion payload exists to
  // hash -- see module header).
  // ==========================================================================
  pub let umnt_audit_record_deferred : (u64) -> () !{mem, sysreg} @{cap, sched} =
    fn (audit_id: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "umount.pdxfs.M3-001 tie-in (#7) + M3 (#9): umnt_audit_record_deferred entry point. `cmp rdi,0; je umnt_audit_deferred_skip` -- a zero audit_id means nothing was opened. Otherwise `lea rsi,[rip+umnt_audit_lit_deferred_schema]` (output_schema, a documentation-only literal naming the deferred marker -- no real schema-registry binding exists, matching src/pipe_wire.pdx's own Registry-inert posture), `xor rdx,rdx` (output_hash = 0, no real payload), `call audit_record_output` (libpdx-audit). Return value discarded (no `mov`) per module header's forgiving posture. No `add reg,[mem]`. No `test`. Labels prefixed umnt_audit_.",
      block: {
        cmp rdi, 0;
        je umnt_audit_deferred_skip;

        lea rsi, [rip + umnt_audit_lit_deferred_schema];
        xor rdx, rdx;
        call audit_record_output;

      umnt_audit_deferred_skip:
        ret;
      }
    }

  // --- output_schema literal for umnt_audit_record_deferred's
  //     documentation-only "schema name" argument (there is no real
  //     schema-registry binding -- see src/pipe_wire.pdx's own module
  //     header for why). ---------------------------------------------
  pub let umnt_audit_lit_deferred_schema : [u8; 32] = "PdxFsUnmountRecord@0.1.DEFERRED\0"

  // ==========================================================================
  // umnt_audit_commit(audit_id, exit_code) -> ()
  //
  //   rdi = audit_id    (umnt_audit_begin's return value -- 0 means "no
  //                       audit record was opened")
  //   rsi = exit_code   (the real process exit status)
  //
  // audit_id == 0 short-circuits to a no-op; a non-zero audit_id calls
  // AuditClient::audit_commit and discards its return value entirely.
  // ==========================================================================
  pub let umnt_audit_commit : (u64, u64) -> () !{mem, sysreg} @{cap, sched} =
    fn (audit_id: u64) (exit_code: u64) -> unsafe {
      effects: {mem, sysreg}, capabilities: {cap, sched},
      justification: "umount.pdxfs.M3 (#9): umnt_audit_commit entry point. `cmp rdi,0; je umnt_audit_commit_skip` -- a zero audit_id means nothing was opened. Otherwise `call audit_commit` with rdi/rsi already in the correct (audit_id, exit_code) position. Return value discarded per module header's forgiving posture. No `add reg,[mem]`. No `test`. Labels prefixed umnt_audit_.",
      block: {
        cmp rdi, 0;
        je umnt_audit_commit_skip;

        call audit_commit;

      umnt_audit_commit_skip:
        ret;
      }
    }
}
