// src/argv.pdx — umount.pdxfs.ENH-030 satellite adoption of libpdx-argv v1.1.0
//
// R90-XREPO satellite cascade, umount.pdxfs branch (issue #23):
// replaces the handwritten long-flag scanner this file used through
// v1.1.1 with a thin wire-in over libpdx-argv (paideia-satellites/
// libpdx-argv v1.1.0, ENH-030 rename tag). Every public symbol callers
// depend on -- the `argv_parse` entry point, the `PA_OFF_*` /
// `PA_FLAG_*` / `PA_STRUCT_BYTES` constants -- keeps its numeric value
// and its byte offset unchanged, so `src/main.pdx`'s direct-offset
// loads (`[r14 + 0]` for flags, `[r14 + 8]` for target_ptr) and every
// tests/ driver's [u8; 16] ParsedArgv buffer continue to work
// byte-for-byte.
//
// ----------------------------------------------------------------------
// libpdx-argv wire-in shape
// ----------------------------------------------------------------------
//
// `argv_parse(argc, argv, out_ptr)` now:
//   1. Zero-initialises the caller's 16-byte ParsedArgv scratch
//      struct (flags = 0, target_ptr = 0).
//   2. Calls `flag_spec_reset()`, then `flag_spec_register()` four
//      times -- once per umount.pdxfs long flag, all four registered
//      as `FKIND_BOOL` (this tool has no value-carrying flags).
//   3. Calls `parsed_args_reset()`.
//   4. Calls `parse_argv(argv+8, argc-1)` -- +8/-1 skips argv[0].
//      Return value IGNORED; the shim reads whatever ParsedArgs holds
//      even on a soft error.
//   5. Walks `flag_ids[0..flag_count)` once, OR-ing the matching
//      PA_FLAG_* bit into the running flags-mask for each FID_* case.
//   6. Populates `PA_OFF_TARGET_PTR` from `pos_ptrs[0]` if
//      `pos_count > 0` -- umount.pdxfs takes exactly one positional
//      (a <mount-id | mount-point>; the mount-id-vs-path classifier
//      lives downstream in src/target_resolve.pdx).
//   7. Returns `ARGV_OK` when a target was found, else
//      `ARGV_ERR_MISSING_TARGET`.
//
// ----------------------------------------------------------------------
// Preserved surface (byte-for-byte with the pre-shim v1.1.1 body)
// ----------------------------------------------------------------------
//
// - PA_OFF_FLAGS = 0, PA_OFF_TARGET_PTR = 8 -- PA_STRUCT_BYTES = 16.
// - PA_FLAG_LAZY = 0x1, PA_FLAG_FORCE = 0x2, PA_FLAG_VERBOSE = 0x4,
//   PA_FLAG_DRY_RUN = 0x8 -- byte-identical bit assignments (matches
//   the task brief's bit0..bit3 spec, which differs from mkfs.pdxfs's
//   own flag ordering -- no shared contract to preserve).
// - ARGV_OK = 0, ARGV_ERR_MISSING_TARGET = 1.
//
// ----------------------------------------------------------------------
// Encoder-gap discipline (per project-wide non-negotiable)
// ----------------------------------------------------------------------
//
// No `add reg, [mem]` anywhere. Byte loads use xor+mov_b per
// paideia-as #1248. No `test` mnemonic; every zero-check is
// `cmp reg, 0`. Every `cmp reg, imm` uses imm ≤ 0x7FFFFFFF (max seen:
// 103 for FID_DRY_RUN). r11 is scratch (used for every lea to a
// cross-module .bss base). Reserved-label discipline: every label
// in this file is prefixed `umnt_argv_`.
//
// Upstream: paideia-satellites/libpdx-argv v1.1.0 (ENH-030 rename);
// design/tooling/volume-tooling-ux.md §5.1 (paideia-os, the frozen
// argv surface this shim implements against).

module Argv = structure {

  // --- ParsedArgv out-struct offsets (unchanged from v1.1.1). -----------
  pub let PA_OFF_FLAGS       : u64 = 0
  pub let PA_OFF_TARGET_PTR  : u64 = 8
  pub let PA_STRUCT_BYTES    : u64 = 16

  // --- ParsedArgv.flags bit assignments (unchanged from v1.1.1). --------
  pub let PA_FLAG_LAZY     : u64 = 0x1
  pub let PA_FLAG_FORCE    : u64 = 0x2
  pub let PA_FLAG_VERBOSE  : u64 = 0x4
  pub let PA_FLAG_DRY_RUN  : u64 = 0x8

  pub let ARGV_OK                    : u64 = 0
  pub let ARGV_ERR_MISSING_TARGET    : u64 = 1

  // --- FID_* numbering (owned by this shim; see module header). ---------
  pub let FID_LAZY     : u64 = 100
  pub let FID_FORCE    : u64 = 101
  pub let FID_VERBOSE  : u64 = 102
  pub let FID_DRY_RUN  : u64 = 103

  // --- Flag-name literals for flag_spec_register (NUL-terminated, no
  //     leading "--" -- libpdx-argv's parser strips the '--' prefix). ---
  pub let umnt_argv_name_lazy     : [u8; 5]  = "lazy\0"
  pub let umnt_argv_name_force    : [u8; 6]  = "force\0"
  pub let umnt_argv_name_verbose  : [u8; 8]  = "verbose\0"
  pub let umnt_argv_name_dry_run  : [u8; 8]  = "dry-run\0"

  // ==========================================================================
  // argv_parse(argc, argv, out_ptr) -> u64
  //   rdi = argc, rsi = argv, rdx = out_ptr (16-byte)
  //   rax = ARGV_OK (0) or ARGV_ERR_MISSING_TARGET (1).
  //
  // Register plan (5 callee-save pushes -> rsp%16 = 0 for nested calls):
  //   rbx = out_ptr        (survives every libpdx-argv call below)
  //   r12 = argc / repurposed after parse_argv to flag_count
  //   r13 = argv / repurposed after parse_argv to loop index i
  //   r14 = accumulated flags mask
  //   r15 = unused past the parse (kept saved for register-parity)
  // ==========================================================================
  pub let argv_parse : (u64, u64, u64) -> u64 !{mem} @{} =
    fn (argc: u64) (argv: u64) (out_ptr: u64) -> unsafe {
      effects: {mem}, capabilities: {},
      justification: "umount.pdxfs.ENH-030 (#23): argv_parse shim over libpdx-argv v1.1.0. Entry rsp%16=8 (post-call); pushes 5 callee-save regs (rbx/r12/r13/r14/r15) -> rsp%16=0 for every nested call site (flag_spec_reset, flag_spec_register x4, parsed_args_reset, parse_argv). rbx holds the caller's out_ptr through every call; r12/r13 initially hold argc/argv (for the argv+8/argc-1 skip) and are repurposed post-parse_argv to flag_count / loop index; r14 accumulates the flags mask. Zero-init pass: writes flags=0, target_ptr=0 into the 16-byte out struct BEFORE any libpdx-argv call. Registration pass: four flag_spec_register calls -- (lazy,BOOL,100), (force,BOOL,101), (verbose,BOOL,102), (dry-run,BOOL,103). Parse: rdi=r13+8 (argv+8 skips argv[0]), rsi=r12-1 (argc-1); call parse_argv; return code IGNORED (see mkfs.pdxfs.ENH-030 for the permissive-posture rationale -- ParsedArgs still holds whatever was parsed on a soft error). Walk pass: r12=[flag_count], r13=0 (loop index), r14=0 (flags mask). Each iteration: r10=flag_ids[r13]; cmp against every FID_* in ascending order; on a match, OR the matching PA_FLAG_* into r14 -- all four flags are booleans so there is no value-side dispatch. Post-walk: writes r14 into PA_OFF_FLAGS (+0). Positional pass: reads pos_count; if > 0, copies pos_ptrs[0] into PA_OFF_TARGET_PTR (+8) -- umount.pdxfs takes exactly one positional. Sets rax=ARGV_OK on target seen, ARGV_ERR_MISSING_TARGET on no positional. Epilogue pops r15/r14/r13/r12/rbx (reverse push order) then rets. No `add reg,[mem]`; no `test` mnemonic; every cmp reg,imm ≤ 0x7FFFFFFF (max 103). Labels prefixed umnt_argv_.",
      block: {
        push rbx;
        push r12;
        push r13;
        push r14;
        push r15;

        mov rbx, rdx;                       // rbx = out_ptr
        mov r12, rdi;                       // r12 = argc
        mov r13, rsi;                       // r13 = argv

        // ---- Zero-init pass. --------------------------------------------
        xor rax, rax;
        mov [rbx + 0], rax;                 // flags = 0
        mov [rbx + 8], rax;                 // target_ptr = 0

        // ---- Register the 4 flags with libpdx-argv's FlagSpec. ----------
        call flag_spec_reset;

        lea rdi, [rip + umnt_argv_name_lazy];
        mov rsi, 0;                         // FKIND_BOOL
        mov rdx, 100;                       // FID_LAZY
        call flag_spec_register;

        lea rdi, [rip + umnt_argv_name_force];
        mov rsi, 0;
        mov rdx, 101;                       // FID_FORCE
        call flag_spec_register;

        lea rdi, [rip + umnt_argv_name_verbose];
        mov rsi, 0;
        mov rdx, 102;                       // FID_VERBOSE
        call flag_spec_register;

        lea rdi, [rip + umnt_argv_name_dry_run];
        mov rsi, 0;
        mov rdx, 103;                       // FID_DRY_RUN
        call flag_spec_register;

        // ---- Reset ParsedArgs bookkeeping + drive the parse. ------------
        call parsed_args_reset;

        mov rdi, r13;
        add rdi, 8;                         // argv+8
        mov rsi, r12;
        sub rsi, 1;                         // argc-1
        call parse_argv;
        // rax = error code; deliberately IGNORED.

        // ---- Walk flag_ids[0..flag_count) once. -------------------------
        lea r11, [rip + flag_count];
        mov r12, [r11];                     // r12 = flag_count
        xor r13, r13;                       // r13 = i = 0
        xor r14, r14;                       // r14 = flags mask = 0

      umnt_argv_walk_loop:
        cmp r13, r12;
        jge umnt_argv_walk_done;

        lea r11, [rip + flag_ids];
        mov r10, [r11 + r13*8];             // r10 = flag_ids[i]

        cmp r10, 100;                       // FID_LAZY
        jne umnt_argv_case_force;
        or r14, 0x1;                        // PA_FLAG_LAZY
        jmp umnt_argv_walk_next;

      umnt_argv_case_force:
        cmp r10, 101;                       // FID_FORCE
        jne umnt_argv_case_verbose;
        or r14, 0x2;                        // PA_FLAG_FORCE
        jmp umnt_argv_walk_next;

      umnt_argv_case_verbose:
        cmp r10, 102;                       // FID_VERBOSE
        jne umnt_argv_case_dry_run;
        or r14, 0x4;                        // PA_FLAG_VERBOSE
        jmp umnt_argv_walk_next;

      umnt_argv_case_dry_run:
        cmp r10, 103;                       // FID_DRY_RUN
        jne umnt_argv_walk_next;
        or r14, 0x8;                        // PA_FLAG_DRY_RUN

      umnt_argv_walk_next:
        add r13, 1;
        jmp umnt_argv_walk_loop;

      umnt_argv_walk_done:
        mov [rbx + 0], r14;                 // flags

        // ---- Positional pass. --------------------------------------------
        lea r11, [rip + pos_count];
        mov rax, [r11];
        cmp rax, 0;
        je umnt_argv_no_target;

        lea r11, [rip + pos_ptrs];
        mov r9, [r11];                      // pos_ptrs[0]
        mov [rbx + 8], r9;                  // target_ptr

        xor rax, rax;                       // ARGV_OK
        jmp umnt_argv_epilogue;

      umnt_argv_no_target:
        mov rax, 1;                         // ARGV_ERR_MISSING_TARGET

      umnt_argv_epilogue:
        pop r15;
        pop r14;
        pop r13;
        pop r12;
        pop rbx;
        ret;
      }
    }
}
